  m_text: "\u0421\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u0438 \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u044F
    \u043D\u0435\u0444\u0442\u0435\u0433\u0430\u0437\u043E\u043F\u0440\u043E\u0432\u043E\u0434\u043E\u0432
    \u0438 \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449 - \u044D\u0442\u043E
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u043D\u0430\u044F \u0441\u0444\u0435\u0440\u0430,
    \u043E\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u044E\u0449\u0430\u044F \u043F\u0440\u043E\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435,
    \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E,
    \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0435, \u0440\u0435\u043C\u043E\u043D\u0442
    \u0438 \u0434\u0438\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u043A\u0443 \u0441\u0438\u0441\u0442\u0435\u043C
    \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u043A\u0438,
    \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u0438 \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F
    \u043D\u0435\u0444\u0442\u0438, \u0433\u0430\u0437\u0430 \u0438 \u043D\u0435\u0444\u0442\u0435\u043F\u0440\u043E\u0434\u0443\u043A\u0442\u043E\u0432,
    \u0442\u0440\u0435\u0431\u0443\u044E\u0449\u0430\u044F \u0437\u043D\u0430\u043D\u0438\u0439
    \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u0438\u0438,
    \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0439 \u0438 \u043D\u043E\u0440\u043C\u0430\u0442\u0438\u0432\u043D\u043E-\u043F\u0440\u0430\u0432\u043E\u0432\u043E\u0439
    \u0431\u0430\u0437\u044B"
