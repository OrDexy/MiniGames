  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0413\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0434\u0438\u0437\u0430\u0439\u043D
    - \u044D\u0442\u043E \u0432\u0438\u0434 \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u043E\u0439
    \u043A\u043E\u043C\u043C\u0443\u043D\u0438\u043A\u0430\u0446\u0438\u0438, \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E
    \u0438 \u0440\u0435\u043C\u0435\u0441\u043B\u043E \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F
    \u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0439
    \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0438 \u0438\u0434\u0435\u0439,
    \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438 \u0438 \u0441\u043C\u044B\u0441\u043B\u043E\u0432
    \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0442\u0438\u043F\u043E\u0433\u0440\u0430\u0444\u0438\u043A\u0438,
    \u0444\u043E\u0440\u043C, \u0446\u0432\u0435\u0442\u043E\u0432, \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0439
    \u0438 \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u0438."
  m_isRightToLeft: 0
